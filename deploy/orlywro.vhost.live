server {
    server_name orlywro.pro www.orlywro.pro;

    root /var/www/orlywro;
    index index.html;

    location / {
        try_files $uri $uri/ =404;
    }

    location ~* \.(jpg|jpeg|png|gif|ico|css|js)$ {
        expires 7d;
        add_header Cache-Control "public";
    }

    location = /game {
        return 301 /game/;
    }
    location ^~ /game/ {
        root /home/ubuntu/orlywro-game;
        index index.html;
        try_files $uri $uri/ =404;
    }
    location /api/ {
        proxy_pass http://127.0.0.1:8502;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 30s;
    }
    location /ws {
        proxy_pass http://127.0.0.1:8502;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
    }
    location = /healthz {
        proxy_pass http://127.0.0.1:8502/healthz;
        proxy_set_header Host $host;
        access_log off;
    }
    location = /druh { return 301 /game/; }
    location ^~ /druh/ { return 301 /game/; }

    listen [::]:443 ssl ipv6only=on; # managed by Certbot
    listen 443 ssl; # managed by Certbot
    ssl_certificate /etc/letsencrypt/live/orlywro.pro/fullchain.pem; # managed by Certbot
    ssl_certificate_key /etc/letsencrypt/live/orlywro.pro/privkey.pem; # managed by Certbot
    include /etc/letsencrypt/options-ssl-nginx.conf; # managed by Certbot
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem; # managed by Certbot
}
server {
    if ($host = www.orlywro.pro) {
        return 301 https://$host$request_uri;
    } # managed by Certbot

    if ($host = orlywro.pro) {
        return 301 https://$host$request_uri;
    } # managed by Certbot

    listen 80;
    listen [::]:80;
    server_name orlywro.pro www.orlywro.pro;
    return 404; # managed by Certbot
}
